{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Harness · 安装依赖",
      "type": "shell",
      "command": "bun install",
      "options": { "cwd": "${workspaceFolder}/harness-lab" },
      "problemMatcher": []
    },
    {
      "label": "Harness · 类型检查",
      "type": "shell",
      "command": "bun run typecheck",
      "options": { "cwd": "${workspaceFolder}/harness-lab" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Harness · 全部测试",
      "type": "shell",
      "command": "bun test --max-concurrency=1",
      "options": { "cwd": "${workspaceFolder}/harness-lab" },
      "problemMatcher": []
    },
    {
      "label": "Harness · 发布验收",
      "type": "shell",
      "command": "bun run verify",
      "options": { "cwd": "${workspaceFolder}/harness-lab" },
      "problemMatcher": ["$tsc"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
