{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "035：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/035-lsp.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false,
      "env": {
        "LSP_DEBUG": "0"
      }
    },
    {
      "name": "Bun：035 LSP父测试",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/lsp-parent-035"
    },
    {
      "name": "Bun：035 LSP子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6502/lsp-035"
    }
  ]
}
