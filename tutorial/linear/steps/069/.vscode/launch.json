{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "069：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/069-cli.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false
    },
    {
      "name": "Bun：CLI 入口",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--no-env-file",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false,
      "args": [
        "/tool read {\"path\":\"package.json\"}"
      ],
      "env": {
        "HARNESS_HOME": "${workspaceFolder}/.data-debug-069",
        "DEEPSEEK_API_KEY": "",
        "HARNESS_SESSION": ""
      }
    }
  ]
}
