{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "061：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/061-webhook.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false
    },
    {
      "name": "061：Webhook监听服务",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/webhook-server.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false,
      "env": {
        "HARNESS_WEBHOOK_SECRET": "local-demo-only"
      }
    }
  ]
}
