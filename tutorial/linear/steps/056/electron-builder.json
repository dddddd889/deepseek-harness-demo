{
  "appId": "dev.harness.own",
  "productName": "Harness Own",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop/**",
    "src/**",
    "web/**",
    "package.json",
    "node_modules/**"
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "notarize": true
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Development"
  },
  "extraResources": [
    {
      "from": ".runtime/bun",
      "to": "bun"
    }
  ]
}
