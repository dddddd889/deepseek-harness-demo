{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "033：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/033-mcp.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false,
      "env": {
        "MCP_DEBUG": "0"
      }
    },
    {
      "name": "Bun：033 MCP父测试进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/mcp-parent-033"
    },
    {
      "name": "Bun：033 MCP子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6501/mcp-033"
    }
  ]
}
