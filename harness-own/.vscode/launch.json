{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bun：032跨进程RPC主进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/rpc-032"
    },
    {
      "name": "Bun：032 RPC worker子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6500/rpc-worker-032"
    },
    {
      "name": "Bun：调试当前文件",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": [
        "--timeout",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "runtime": "bun"
    },
    {
      "name": "Bun：035 LSP父测试",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/lsp-parent-035"
    },
    {
      "name": "Bun：035 LSP子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6502/lsp-035"
    },
    {
      "name": "Bun：032当前传输示例",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "env": {
        "RPC_DEMO_TIMEOUT_MS": "3600000"
      },
      "stopOnEntry": false
    },
    {
      "name": "Bun：039独立事件记录",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/collaboration-demo.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": ["--preload", "${workspaceFolder}/scripts/vscode-debug.mjs"],
      "stopOnEntry": false
    },
    {
      "name": "041：会话管理演示",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/host-demo.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false
    }
  ]
}
