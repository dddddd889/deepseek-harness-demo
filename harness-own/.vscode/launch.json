{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bun：032跨进程RPC主进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/rpc-032"
    },
    {
      "name": "Bun：032 RPC worker子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6500/rpc-worker-032"
    },
    {
      "name": "Bun：调试当前文件",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "cwd": "${workspaceFolder}",
      "runtime": "bun"
    },
    {
      "name": "Bun：035 LSP父测试",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/lsp-parent-035"
    },
    {
      "name": "Bun：035 LSP子进程",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6502/lsp-035"
    },
    {
      "name": "Bun：032当前传输示例",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "env": {
        "RPC_DEMO_TIMEOUT_MS": "3600000"
      },
      "stopOnEntry": false
    },
    {
      "name": "Bun：039独立事件记录",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/collaboration-demo.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false
    },
    {
      "name": "041：会话管理演示",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/host-demo.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false
    },
    {
      "name": "Bun：044：SDK运行演示 CLI 入口",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "args": [
        "读取 README"
      ],
      "stopOnEntry": false
    },
    {
      "name": "Bun：当前测试",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false,
      "env": {
        "SDK_DEBUG_HOST": "1",
        "ACP_TRACE": "1",
      }
    },
    {
      "name": "Bun：044：SDK运行演示 附加子进程",
      "type": "bun",
      "request": "attach",
      "url": "${input:bunInspectorUrl}"
    },
    {
      "name": "044：SDK运行演示",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/sdk-demo.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false
    },
    {
      "name": "044：SDK固定测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/044-sdk.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "env": {
        "SDK_DEBUG_HOST": "0"
      },
      "stopOnEntry": false
    },
    {
      "name": "044：SDK测试（等待附加Host）",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/044-sdk.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "env": {
        "SDK_DEBUG_HOST": "1"
      },
      "stopOnEntry": false
    },
    {
      "name": "Python：SDK 客户端",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/fixtures/python-sdk.py",
      "cwd": "${workspaceFolder}",
      "python": "/usr/bin/python3",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/python"
      },
      "args": [
        "bun",
        "${workspaceFolder}/src/sdk-server.mjs",
        "${workspaceFolder}/.data-python-debug"
      ],
      "justMyCode": true
    },
    {
      "name": "Web：Bun Host",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/web-server.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "env": {
        "HARNESS_HOME": "${workspaceFolder}/.data-web",
        "HARNESS_PORT": "0"
      },
      "stopOnEntry": false
    },
    {
      "name": "Web：页面",
      "type": "chrome",
      "request": "launch",
      "url": "${input:webBootstrapUrl}",
      "webRoot": "${workspaceFolder}/web",
      "pathMapping": {
        "/view.mjs": "${workspaceFolder}/src/view.mjs"
      }
    },
    {
      "name": "052：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/052-desktop-policy.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false
    },
    {
      "name": "Electron：Main",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Electron：Bun Host",
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/harness-host"
    },
    {
      "name": "Electron：Renderer",
      "type": "chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9222,
      "webRoot": "${workspaceFolder}/web",
      "pathMapping": {
        "/view.mjs": "${workspaceFolder}/src/view.mjs"
      }
    },
    {
      "name": "061：本节测试",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/tests/061-webhook.test.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "test",
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs",
        "--timeout",
        "3600000"
      ],
      "stopOnEntry": false
    },
    {
      "name": "061：Webhook监听服务",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/webhook-server.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false,
      "env": {
        "HARNESS_WEBHOOK_SECRET": "local-demo-only"
      }
    },
    {
      "name": "061：Webhook发送请求",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/send-webhook.mjs",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/scripts/vscode-debug.mjs"
      ],
      "stopOnEntry": false,
      "env": {
        "HARNESS_WEBHOOK_SECRET": "local-demo-only",
        "HARNESS_WEBHOOK_TIMEOUT_MS": "600000"
      },
      "args": [
        "${input:webhookUrl}",
        "${input:webhookPrompt}",
        "${input:webhookDelivery}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "bunInspectorUrl",
      "type": "promptString",
      "description": "粘贴子进程 Bun Inspector 打印的完整 ws:// 地址"
    },
    {
      "id": "webBootstrapUrl",
      "type": "promptString",
      "description": "粘贴本次 Host 输出的完整 http://127.0.0.1:端口/?token=... 地址"
    },
    {
      "id": "webhookUrl",
      "type": "promptString",
      "description": "粘贴本次服务打印的完整http://127.0.0.1:端口/webhooks地址"
    },
    {
      "id": "webhookPrompt",
      "type": "promptString",
      "description": "本次Webhook任务",
      "default": "帮我处理这条通知"
    },
    {
      "id": "webhookDelivery",
      "type": "promptString",
      "description": "投递ID；相同ID与正文用于验证重复，新任务请换ID",
      "default": "debug-delivery-1"
    }
  ]
}