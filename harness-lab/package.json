{
  "name": "deepseek-harness-from-zero-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": ["dist/src", "dist/web"],
  "bin": {
    "dsh-lab": "dist/src/cli-entry.js",
    "dsh-lab-web": "dist/src/web-server-entry.js"
  },
  "scripts": {
    "demo": "bun src/demo.ts",
    "demo:protocol": "bun src/protocol-demo.ts",
    "demo:llm": "bun src/llm-demo.ts",
    "demo:agent": "bun src/agent-demo.ts",
    "demo:tools": "bun src/tools-demo.ts",
    "demo:local": "bun src/local-capabilities-demo.ts",
    "demo:permissions": "bun src/permissions-demo.ts",
    "demo:persistence": "bun src/persistence-demo.ts",
    "demo:context": "bun src/context-compaction-demo.ts",
    "demo:spill": "bun src/spill-principle-demo.ts",
    "demo:spill-types": "bun src/spill-file-types-demo.ts",
    "demo:capabilities": "bun src/capabilities-demo.ts",
    "demo:orchestration": "bun src/orchestration-demo.ts",
    "demo:headless": "bun src/headless-demo.ts",
    "demo:server": "bun src/agent-server-demo.ts",
    "demo:web": "bun src/web-demo.ts",
    "demo:observability": "bun src/observability-demo.ts",
    "demo:hardening": "bun src/hardening-demo.ts",
    "serve:web": "bun src/web-server-entry.ts",
    "cli": "bun src/cli-entry.ts",
    "build": "bun x tsc -p tsconfig.build.json && rm -rf dist/web && cp -R web dist/web",
    "smoke": "bun dist/src/cli-entry.js --help && bun dist/src/release-smoke.js",
    "verify": "bun run typecheck && bun test --max-concurrency=1 && bun run build && bun run smoke",
    "typecheck": "bun x tsc -p tsconfig.json",
    "test": "bun test --max-concurrency=1"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
