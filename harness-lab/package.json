{
  "name": "deepseek-harness-from-zero-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": ["dist/src", "dist/web"],
  "bin": {
    "dsh-lab": "dist/src/cli-entry.js",
    "dsh-lab-web": "dist/src/web-server-entry.js"
  },
  "scripts": {
    "demo": "bun src/demo.ts",
    "demo:protocol": "bun src/protocol-demo.ts",
    "demo:llm": "bun src/llm-demo.ts",
    "demo:agent": "bun src/agent-demo.ts",
    "demo:tools": "bun src/tools-demo.ts",
    "demo:local": "bun src/local-capabilities-demo.ts",
    "demo:permissions": "bun src/permissions-demo.ts",
    "demo:persistence": "bun src/persistence-demo.ts",
    "demo:context": "bun src/context-compaction-demo.ts",
    "demo:capabilities": "bun src/capabilities-demo.ts",
    "demo:orchestration": "bun src/orchestration-demo.ts",
    "demo:headless": "bun src/headless-demo.ts",
    "demo:server": "bun src/agent-server-demo.ts",
    "demo:web": "bun src/web-demo.ts",
    "demo:observability": "bun src/observability-demo.ts",
    "demo:hardening": "bun src/hardening-demo.ts",
    "serve:web": "bun src/web-server-entry.ts",
    "cli": "bun src/cli-entry.ts",
    "build": "bun x tsc -p tsconfig.build.json && rm -rf dist/web && cp -R web dist/web",
    "smoke": "bun dist/src/cli-entry.js --help && bun dist/src/release-smoke.js",
    "verify": "bun run typecheck && bun test --max-concurrency=1 && bun run build && bun run smoke",
    "typecheck": "bun x tsc -p tsconfig.json",
    "test": "bun test --max-concurrency=1",
    "debug:test": "bun --inspect-brk test --max-concurrency=1 src/context.test.ts",
    "debug:protocol": "bun --inspect-brk test --max-concurrency=1 src/domain.test.ts",
    "debug:projection": "bun --inspect-brk test --max-concurrency=1 src/projections.test.ts",
    "debug:llm": "bun --inspect-brk test --max-concurrency=1 src/llm.test.ts",
    "debug:deepseek": "bun --inspect-brk test --max-concurrency=1 src/deepseek-provider.test.ts",
    "debug:agent": "bun --inspect-brk test --max-concurrency=1 src/agent.test.ts",
    "debug:tools": "bun --inspect-brk test --max-concurrency=1 src/tools.test.ts",
    "debug:fs": "bun --inspect-brk test --max-concurrency=1 src/workspace-fs.test.ts",
    "debug:process": "bun --inspect-brk test --max-concurrency=1 src/local-process.test.ts",
    "debug:permissions": "bun --inspect-brk test --max-concurrency=1 src/permissions.test.ts",
    "debug:persistence": "bun --inspect-brk test --max-concurrency=1 src/session-store.test.ts",
    "debug:context": "bun --inspect-brk test --max-concurrency=1 src/context-compaction.test.ts",
    "debug:capabilities": "bun --inspect-brk test --max-concurrency=1 src/capabilities.test.ts",
    "debug:jobs": "bun --inspect-brk test --max-concurrency=1 src/jobs.test.ts",
    "debug:subagents": "bun --inspect-brk test --max-concurrency=1 src/subagents.test.ts",
    "debug:workflow": "bun --inspect-brk test --max-concurrency=1 src/workflow.test.ts",
    "debug:headless": "bun --inspect-brk test --max-concurrency=1 src/headless.test.ts",
    "debug:server": "bun --inspect-brk test --max-concurrency=1 src/agent-server.test.ts",
    "debug:web": "bun --inspect-brk test --max-concurrency=1 src/client-runtime.test.ts",
    "debug:observability": "bun --inspect-brk test --max-concurrency=1 src/session-telemetry.test.ts src/cost-projection.test.ts",
    "debug:hardening": "bun --inspect-brk test --max-concurrency=1 src/hardening.test.ts",
    "debug:demo": "bun --inspect-brk src/demo.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
